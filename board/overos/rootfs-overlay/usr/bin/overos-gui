#!/bin/sh
set -eu
if ! command -v startx >/dev/null 2>&1; then
    echo "OverOS: servidor grafico nao instalado; continue pelo terminal."
    exit 1
fi
if ! command -v openbox-session >/dev/null 2>&1; then
    echo "OverOS: Openbox nao esta disponivel."
    exit 1
fi
if [ -x /usr/bin/Xfbdev ]; then
    exec startx /usr/bin/openbox-session -- /usr/bin/Xfbdev :0 -nolisten tcp
fi
echo "OverOS: servidor Xfbdev nao encontrado; fallback para terminal."
exit 1
