<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <!-- Presentation skeleton; the shell binds events to its authorized Wayland adapter. -->
  <object class="GtkBox" id="overos_virtual_keyboard">
    <property name="orientation">vertical</property>
    <property name="spacing">6</property>
    <property name="css-classes">overos-keyboard</property>
    <child><object class="GtkBox" id="keyboard_row_numbers">
      <property name="orientation">horizontal</property><property name="spacing">6</property><property name="css-classes">overos-keyboard-row</property>
      <child><object class="GtkButton" id="key_1"><property name="label">1</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_2"><property name="label">2</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_3"><property name="label">3</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_4"><property name="label">4</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_5"><property name="label">5</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_6"><property name="label">6</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_7"><property name="label">7</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_8"><property name="label">8</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_9"><property name="label">9</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_0"><property name="label">0</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_backspace"><property name="label">⌫</property><property name="css-classes">overos-key,utility</property></object></child>
    </object></child>
    <child><object class="GtkBox" id="keyboard_row_1"><property name="orientation">horizontal</property><property name="spacing">6</property><property name="css-classes">overos-keyboard-row</property><child><object class="GtkButton" id="key_q"><property name="label">Q</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_w"><property name="label">W</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_e"><property name="label">E</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_r"><property name="label">R</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_t"><property name="label">T</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_y"><property name="label">Y</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_u"><property name="label">U</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_i"><property name="label">I</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_o"><property name="label">O</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_p"><property name="label">P</property><property name="css-classes">overos-key</property></object></child></object></child>
    <child><object class="GtkBox" id="keyboard_row_2"><property name="orientation">horizontal</property><property name="spacing">6</property><property name="css-classes">overos-keyboard-row</property><child><object class="GtkButton" id="key_a"><property name="label">A</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_s"><property name="label">S</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_d"><property name="label">D</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_f"><property name="label">F</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_g"><property name="label">G</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_h"><property name="label">H</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_j"><property name="label">J</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_k"><property name="label">K</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_l"><property name="label">L</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_ccedilla"><property name="label">Ç</property><property name="css-classes">overos-key</property></object></child></object></child>
    <child><object class="GtkBox" id="keyboard_row_3"><property name="orientation">horizontal</property><property name="spacing">6</property><property name="css-classes">overos-keyboard-row</property><child><object class="GtkButton" id="key_shift"><property name="label">⇧</property><property name="css-classes">overos-key ,utility</property></object></child><child><object class="GtkButton" id="key_z"><property name="label">Z</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_x"><property name="label">X</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_c"><property name="label">C</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_v"><property name="label">V</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_b"><property name="label">B</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_n"><property name="label">N</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_m"><property name="label">M</property><property name="css-classes">overos-key</property></object></child><child><object class="GtkButton" id="key_enter"><property name="label">↵</property><property name="css-classes">overos-key ,utility</property></object></child></object></child>
    <child><object class="GtkBox" id="keyboard_row_space">
      <property name="orientation">horizontal</property><property name="spacing">6</property><property name="css-classes">overos-keyboard-row</property>
      <child><object class="GtkButton" id="key_symbols"><property name="label">?123</property><property name="css-classes">overos-key,utility</property></object></child>
      <child><object class="GtkButton" id="key_space"><property name="label">Espaço</property><property name="hexpand">true</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_period"><property name="label">.</property><property name="css-classes">overos-key</property></object></child>
      <child><object class="GtkButton" id="key_hide"><property name="label">Ocultar</property><property name="css-classes">overos-key,utility</property></object></child>
    </object></child>
  </object>
</interface>
