diff --git a/components/overos-touchscreen.xml b/components/overos-touchscreen.xml
new file mode 100644
--- /dev/null
+++ b/components/overos-touchscreen.xml
@@ -0,0 +1,14 @@
+<image>
+	<profiles>
+		<profile name="OverOS-Touchscreen" description="Touchscreen runtime support and diagnostics">
+			<requires profile="BaseCommon"/>
+		</profile>
+	</profiles>
+	<packages type="image" patternType="plusRecommended" profiles="OverOS-Touchscreen">
+		<!-- Kernel drivers are selected by the detected controller and loaded by udev. -->
+		<package name="libinput"/>
+		<package name="libinput-utils"/>
+		<package name="evtest"/>
+		<package name="linux-firmware"/>
+	</packages>
+</image>
